    "@types/react": "19.2.14",
    "react": "19.3.0",
    "ol": "10.10.0",
    "@georeferencing/react": "workspace:*",
    "@georeferencing/plugins": "workspace:*",
    "@playwright/test": "1.63.0",
    "@georeferencing/openlayers": "workspace:*",
    "@georeferencing/maplibre": "workspace:*",
    "@georeferencing/leaflet": "workspace:*",
    "maplibre-gl": "6.12.0",
    "leaflet": "1.9.4",
    "@types/leaflet": "1.9.22",
    "terra-draw": "1.36.0",
    "terra-draw-maplibre-gl-adapter": "1.4.1",
    "terra-draw-leaflet-adapter": "1.3.0",
