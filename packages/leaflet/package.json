{
  "name": "@georeferencing/leaflet",
  "version": "0.5.0",
  "description": "Leaflet map adapter for georeferencing: overlay, control points, drawing (Terra Draw), snapping and reference layers",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "@georeferencing/core": "workspace:^",
    "leaflet": "^1.9.4",
    "terra-draw": "^1.36.0",
    "terra-draw-leaflet-adapter": "^1.3.0"
  },
  "peerDependenciesMeta": {
    "terra-draw": {
      "optional": true
    },
    "terra-draw-leaflet-adapter": {
      "optional": true
    }
  },
  "devDependencies": {
    "@georeferencing/core": "workspace:*",
    "typescript": "5.9.3",
    "leaflet": "1.9.4",
    "@types/leaflet": "1.9.22",
    "terra-draw": "1.36.0",
    "terra-draw-leaflet-adapter": "1.3.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs leaflet",
    "dev": "node ../../scripts/build-package.mjs leaflet --watch",
    "typecheck": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "prepack": "pnpm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobilg/georeferencing.git",
    "directory": "packages/leaflet"
  },
  "homepage": "https://github.com/tobilg/georeferencing#readme",
  "bugs": {
    "url": "https://github.com/tobilg/georeferencing/issues"
  },
  "keywords": [
    "georeferencing",
    "leaflet",
    "gis",
    "typescript"
  ]
}
