{
  "name": "@georeferencing/core",
  "version": "0.3.0",
  "description": "Headless browser georeferencing state, transforms, image processing and OpenLayers integration",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./engine": {
      "types": "./dist/engine/index.d.ts",
      "import": "./dist/engine/index.js"
    },
    "./openlayers": {
      "types": "./dist/openlayers/index.d.ts",
      "import": "./dist/openlayers/index.js"
    },
    "./worker": "./dist/engine/worker.js",
    "./encoder-worker": {
      "types": "./dist/engine/encoder-worker.d.ts",
      "import": "./dist/engine/encoder-worker.js"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "ol": ">=10.10.0 <11"
  },
  "dependencies": {
    "@types/geojson": "^7946.0.16",
    "ml-matrix": "^6.12.1",
    "proj4": "^2.22.0"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "ol": "10.10.0",
    "typescript": "5.9.3",
    "geotiff": "3.0.5",
    "jpeg-js": "0.4.4"
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs core",
    "dev": "node ../../scripts/build-package.mjs core --watch",
    "typecheck": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "prepack": "pnpm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobilg/georeferencing.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/tobilg/georeferencing#readme",
  "bugs": {
    "url": "https://github.com/tobilg/georeferencing/issues"
  },
  "keywords": [
    "georeferencing",
    "react",
    "openlayers",
    "geotiff",
    "gis",
    "typescript"
  ],
  "peerDependenciesMeta": {
    "ol": {
      "optional": true
    }
  }
}
