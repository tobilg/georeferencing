{
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "homepage": "https://github.com/tobilg/georeferencing#readme",
  "bugs": {
    "url": "https://github.com/tobilg/georeferencing/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "name": "@georeferencing/react",
  "description": "React panels and editor for the headless georeferencing core and optional export plugins",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "dependencies": {
    "@georeferencing/core": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=19.3.0 <20",
    "react-dom": ">=19.3.0 <20",
    "ol": ">=10.10.0 <11"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ol": "10.10.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3"
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs react",
    "dev": "node ../../scripts/build-package.mjs react --watch",
    "typecheck": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "prepack": "pnpm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobilg/georeferencing.git",
    "directory": "packages/react"
  }
}
