{
  "name": "georeferencing-workspace",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": "12.x"
  },
  "scripts": {
    "dev": "pnpm build:packages && pnpm --parallel --filter \"@georeferencing/*\" --filter \"!@georeferencing/documentation\" run dev",
    "build": "pnpm -r run build",
    "build:core": "pnpm --filter @georeferencing/core run build",
    "build:demo": "pnpm --filter @georeferencing/demo... run build",
    "lint": "biome check . --error-on-warnings",
    "lint:fix": "biome check --write . --error-on-warnings",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:consumer": "node scripts/consumer.mjs",
    "typecheck": "pnpm build:packages && pnpm -r run typecheck && tsc --noEmit",
    "docs:build": "pnpm build:packages && pnpm --filter @georeferencing/documentation run build",
    "docs:check": "pnpm --filter @georeferencing/documentation run check",
    "docs:dev": "pnpm build:packages && pnpm --filter @georeferencing/documentation run dev",
    "docs:preview": "pnpm --filter @georeferencing/documentation run preview",
    "test:docs": "pnpm docs:build && pnpm --filter @georeferencing/documentation run test",
    "build:packages": "pnpm --filter \"@georeferencing/*\" --filter \"!@georeferencing/demo\" --filter \"!@georeferencing/documentation\" run build",
    "pack:packages": "pnpm build:packages && node scripts/pack-packages.mjs",
    "release:check": "pnpm pack:packages && node scripts/check-package-contents.mjs",
    "dev:harness": "vite --config tests/browser/harness/vite.config.ts",
    "version:set": "node scripts/set-version.mjs"
  },
  "devDependencies": {
    "@georeferencing/core": "workspace:*",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.15",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "vitest": "4.1.11",
    "ol": "10.10.0",
    "@types/geojson": "7946.0.16",
    "geotiff": "3.0.5",
    "@georeferencing/plugins": "workspace:*",
    "@georeferencing/react": "workspace:*",
    "esbuild": "0.28.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@georeferencing/openlayers": "workspace:*",
    "@georeferencing/maplibre": "workspace:*",
    "maplibre-gl": "6.12.0",
    "terra-draw": "1.36.0",
    "terra-draw-maplibre-gl-adapter": "1.4.1",
    "@georeferencing/leaflet": "workspace:*",
    "leaflet": "1.9.4",
    "@types/leaflet": "1.9.22",
    "terra-draw-leaflet-adapter": "1.3.0"
  }
}
